{
  "manifest_version": 3,
  "name": "Blob 图片顺序下载",
  "description": "按阅读顺序下载网页 blob 图片，或将全部图片合并为一个 PDF。",
  "version": "1.1.0",
  "homepage_url": "https://github.com/gulzxeric/blob-image-downloader",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "downloads", "storage", "offscreen"],
  "action": {
    "default_title": "Blob 图片顺序下载",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
  },
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "background.js"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
